# 复制为 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略；不要把真实凭据提交到仓库或写进命令历史。
# 下面带 replace- 前缀的值只是占位符，必须在首次启动前替换。

# 首次启动创建管理员（密码至少 12 位）
WORKDSH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
WORKDSH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
WORKDSH_ORGANIZATION_NAME=WorkDSH 企业

# 32 字节随机密钥的 Base64，生成：openssl rand -base64 32
WORKDSH_SECRETS_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# 服务器间服务密钥，生成：openssl rand -hex 32
WORKDSH_SECRETS_SERVICE_KEY=replace-with-openssl-rand-hex-32

# 访问入口。改端口时必须同时改 WORKDSH_ADMIN_WEB_ORIGIN，否则登录等写请求会被 Origin 校验拒绝。
WORKDSH_ADMIN_BIND_ADDRESS=127.0.0.1
WORKDSH_ADMIN_PORT=18890
WORKDSH_ADMIN_WEB_ORIGIN=http://127.0.0.1:18890

# 仅 PostgreSQL 叠加栈需要；默认 H2 栈忽略这些值。
WORKDSH_DB_NAME=workdsh
WORKDSH_DB_MAINT_USER=workdsh_owner
WORKDSH_DB_MAINT_PASSWORD=replace-with-maintenance-role-password
WORKDSH_DB_APP_PASSWORD=replace-with-app-role-password
