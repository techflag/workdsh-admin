{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workdsh:enterprise-runtime-identity:v1",
  "title": "WorkDSH enterprise runtime identity v1 successful response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "principalId",
    "organizationId",
    "organizationName",
    "role",
    "membershipRevision",
    "active"
  ],
  "properties": {
    "contractVersion": { "type": "integer", "const": 1 },
    "principalId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "organizationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "organizationName": { "type": "string", "minLength": 1, "maxLength": 256 },
    "role": { "type": "string", "enum": ["OWNER", "ADMIN", "MEMBER"] },
    "membershipRevision": { "type": "integer", "minimum": 1 },
    "active": { "type": "boolean", "const": true }
  }
}
